assets/images/ui-rpg/header.png
assets/images/ui-rpg/hud.png
assets/images/ui-rpg/inventory*.png
assets/images/ui-rpg/memory-shard.png
assets/images/ui-rpg/menu-panel-v3.png
assets/images/ui-rpg/panel.png
assets/images/ui-rpg/pangea-title.png
assets/images/ui-rpg/skill*.png
assets/images/ui-rpg/slot.png
assets/scene/20261010_Pandora.glb
assets/scene/modelos/Meshy_AI_*.glb
assets/scene/modelos/PP_*.glb
assets/scene/modelos/animaciones/Attack_Sword_emote.glb
assets/scene/modelos/animaciones/Chop_Axe_emote.glb
assets/scene/modelos/animaciones/PP_*_emote.glb
